{
  "name": "FastAPI Dev",
  "dockerComposeFile": "compose.yml",
  "service": "fastapi",
  "workspaceFolder": "/app",

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.autoImportCompletions": true,
        "python.analysis.typeCheckingMode": "standard"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },

  "remoteUser": "root"
}
